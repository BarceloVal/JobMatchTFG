<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Job_Match.Maui.LoginPage">

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Forma de color rojo (decoración) -->
        <Path
            Stroke="#000"
            Fill="#980c0f"
            Data="m202.59145,194.89999c-123.48078,0 -225.59145,-67.52315 -225.59145,-148.85743c0,-81.33428 100.01943,-154.14258 223.50023,-154.14258c123.48078,0 222.55917,74.72198 223.50023,154.14258c0.94106,79.42059 -97.92821,148.85743 -221.40899,148.85743l-0.00001,0z"/>

        <!-- Logo -->
        <Image
            Source="jobmatchwhite.png"
            HeightRequest="130"
            WidthRequest="130"
            Margin="0, 0, 0, 45"/>

        <!-- Cuerpo -->
        <Grid RowSpacing="5" Grid.Row="1" Margin="20, 80, 20, 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <Label
                Grid.Row="1"
                Text="¡Bienvenido/a!"
                HorizontalOptions="Center"
                FontSize="Title"
                FontAttributes="Bold"
                Padding="0"
                Margin="0"/>

            <!-- Subtítulo -->
            <Label
                Grid.Row="2"
                Text="Inicia sesión para continuar"
                HorizontalOptions="Center"
                FontSize="Subtitle"/>

            <!-- Entrada de datos -->
            <StackLayout
                Grid.Row="3"
                Orientation="Vertical"
                HorizontalOptions="FillAndExpand"
                Margin="0">

                <!-- Usuario/Mail -->
                <Frame
                    BackgroundColor="Transparent"
                    BorderColor="Black"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    CornerRadius="30"
                    Margin="0, 5, 0, 10">

                    <StackLayout
                        Orientation="Horizontal"
                        HorizontalOptions="FillAndExpand"
                        Padding="5">

                        <Frame
                            HeightRequest="40"
                            WidthRequest="40"
                            CornerRadius="30"
                            Padding="5"
                            HasShadow="False"
                            BackgroundColor="Transparent">

                            <!-- Imagen de mail -->
                            <Image
                                Source="mail.png"
                                Aspect="AspectFit"
                                WidthRequest="28"
                                HeightRequest="28"/>
                        </Frame>

                        <!-- Entrada de datos (mail) -->
                        <Entry
                            Text="{Binding UserName}"
                            Placeholder="Introduce tu mail"
                            TextColor="Black"
                            VerticalOptions="Center"
                            HorizontalOptions="FillAndExpand"
                            Margin="5,0"/>
                    </StackLayout>
                </Frame>

                <!-- Contraseña -->
                <Frame
                    BackgroundColor="Transparent"
                    BorderColor="Black"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    CornerRadius="30"
                    Margin="0, 10, 0, 5">

                    <StackLayout
                        Orientation="Horizontal"
                        HorizontalOptions="FillAndExpand"
                        Padding="5">

                        <Frame
                            HeightRequest="40"
                            WidthRequest="40"
                            CornerRadius="30"
                            Padding="5"
                            HasShadow="False"
                            BackgroundColor="Transparent">

                            <!-- Imagen contraseña -->
                            <Image
                                Source="password.png"
                                Aspect="AspectFit"
                                WidthRequest="28"
                                HeightRequest="28"/>
                        </Frame>

                        <!-- Entrada de datos (contraseña) -->
                        <Entry
                            Text="{Binding Password}"
                            IsPassword="True"
                            Placeholder="Introduce tu contraseña"
                            TextColor="Black"
                            VerticalOptions="Center"
                            HorizontalOptions="FillAndExpand"
                            Margin="5,0"/>
                    </StackLayout>
                </Frame>

                <!-- Recordar contraseña -->
                <StackLayout Orientation="Horizontal" Margin="0, 10, 0, 0" Padding="0">
                    <CheckBox IsChecked="False" />
                    <Label Text="Recuerdame la contraseña" TextColor="Black" FontSize="Small" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                </StackLayout>

                <!-- Botón para iniciar sesión -->
                <Button Text="Iniciar sesión" BackgroundColor="#980c0f" TextColor="White" FontAttributes="Bold" CornerRadius="30" WidthRequest="350" Margin="0, 20, 0, 20" Command="{Binding LoginCommand}"/>

                <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand" Margin="0, 60, 0, 0" Padding="0">
                    <Label Text="¿Eres nuevo/a?" TextColor="DarkGray" FontSize="Small"/>
                    <Label Text="Créate una cuenta" TextColor="LightBlue" FontAttributes="Bold" FontSize="Small"/>
                </StackLayout>
            </StackLayout>
        </Grid>
    </Grid>



</ContentPage>