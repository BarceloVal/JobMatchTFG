<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Job_Match.Maui.Views.ChangeProfileToClient">

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Capa 1: el Path rojo -->
        <Path
            Grid.Row="0"
            Stroke="#000"
            Fill="#980c0f"
            Data="m201.48868,122.90001c-117.40352,0 -214.48868,-62.39763 -214.48868,-137.55803c0,-75.1604 95.09685,-142.442 212.50038,-142.442c117.40352,0 211.60564,69.05002 212.50038,142.442c0.89474,73.39197 -93.10855,137.55803 -210.51207,137.55803z" />

        <!-- Capa 2: el logo encima -->
        <Image
            Grid.Row="0"
            Source="jobmatchwhite.png"
            HeightRequest="80"
            WidthRequest="80"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- Título -->
        <StackLayout Grid.Row="1" Padding="0">
            <Label
                Text="Cambiate a cliente"
                TextColor="Black"
                FontSize="35"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Cliente"
                TextColor="Black"
                FontSize="20"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"/>
        </StackLayout>

        <!-- Cuerpo/Formulario -->
        <ScrollView Grid.Row="2" Margin="20, 50, 20, 20">
            <Frame
                Padding="20"
                CornerRadius="30"
                BorderColor="Black"
                HasShadow="False"
                BackgroundColor="White">

                <!-- Campos -->
                <VerticalStackLayout>
                    <!-- Nombre-->
                    <HorizontalStackLayout>
                        <Label
                            Text="Nombre"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding FirstName}"
                        TextColor="Black"
                        Placeholder="Introduce tu nombre"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsFirstNameValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding FirstNameError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsFirstNameValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Apellido-->
                    <HorizontalStackLayout>
                        <Label
                            Text="Apellido"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding LastName}"
                        TextColor="Black"
                        Placeholder="Introduce tu apellido"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsLastNameValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding LastNameError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsLastNameValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Tipo de documento -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Tipo de documento"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">

                        <Picker
                            Title="Selecciona un tipo de documento"
                            ItemsSource="{Binding DocTypes}"
                            ItemDisplayBinding="{Binding name}"
                            SelectedItem="{Binding SelectedDocType}" />

                        <!-- Flecha decorativa -->
                        <Image Source="arrowdown.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="End"
                               Margin="0,0,10,10"/>
                    </Grid>

                    <!-- Documento -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Documento"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Document}"
                        TextColor="Black"
                        Placeholder="Introduce tu documento"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsDocumentValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding DocumentError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsDocumentValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Dirección -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Dirección"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Address}"
                        Placeholder="Introduce tu dirección"
                        BackgroundColor="Transparent"
                        TextColor="Black"/>
                    <Label
                        Text="{Binding AddressError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsAddressValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Código postal -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Población"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Picker
                            Title="Selecciona código postal"
                            ItemsSource="{Binding PostalCodes}"
                            SelectedItem="{Binding SelectedPostalCode}"
                            ItemDisplayBinding="{Binding DisplayText}"/>

                        <!-- Flecha decorativa -->
                        <!--<Image Source="arrowdown.png"
                        HeightRequest="20"
                        WidthRequest="20"
                        HorizontalOptions="End"
                        Margin="0,0,10,10"/>-->
                    </Grid>

                    <!-- Teléfono 1 -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Teléfono 1"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Phone1}"
                        Placeholder="Introduce tu teléfono"
                        Keyboard="Telephone"
                        BackgroundColor="Transparent"
                        TextColor="Black"/>
                    <Label
                        Text="{Binding Phone1Error}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsPhone1Valid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Teléfono 2 -->
                    <Label
                        Text="Teléfono 2"
                        TextColor="Black"
                        FontSize="15"
                        Margin="0, 20, 0, 0"/>
                    <Entry
                        Text="{Binding Phone2}"
                        Placeholder="Introduce otro teléfono (opcional)"
                        Keyboard="Telephone"
                        BackgroundColor="Transparent"
                        TextColor="Black"/>
                    <Label
                        Text="{Binding Phone2Error}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsPhone2Valid, Converter={StaticResource InverseBoolConverter}}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>

        <Button
            Grid.Row="3"
            x:Name="btnChangeClient"
            Text="Crear cuenta"
            BackgroundColor="#980c0f"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="18"
            CornerRadius="30"
            WidthRequest="350"
            Margin="0, 10, 0, 20"
            Clicked="btnChangeClient_Clicked"/>

    </Grid>

</ContentPage>