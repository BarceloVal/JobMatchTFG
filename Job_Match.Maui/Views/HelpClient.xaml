<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.HelpClient"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <controls:HeaderControl />

            <VerticalStackLayout Spacing="20" Padding="20">

                <Label Text="Ayuda para usuarios clientes"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#980c0f" />

                <!-- Buscar proveedores -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Buscar proveedores"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Explora proveedores por ubicación, tipo de servicio y servicio específico. Podrás ver su nombre comercial, zona, descripción y acceder a su perfil para contactarlos o iniciar una conversación si corresponde."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Crear ofertas abiertas -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Crear ofertas abiertas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Publica una solicitud de servicio para que los proveedores se postulen. Define el producto, tipo, fecha de retiro, contacto y más. Luego podrás ver quién se ha inscrito, revisar sus perfiles y decidir con quién avanzar."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Ver mis ofertas -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Gestionar mis ofertas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Consulta las ofertas que has publicado. Puedes ver el estado, editar el contenido, desactivarlas si ya no las necesitas, y gestionar la lista de proveedores inscritos."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Ver y dar valoraciones -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Valoraciones"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Después de interactuar con un proveedor, puedes dejarle una valoración. También puedes consultar las valoraciones que otros usuarios han dejado sobre ti y eliminar las que tú hayas escrito."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Chats con proveedores -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Chats con proveedores"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Puedes enviar mensajes a los proveedores desde sus perfiles o desde las ofertas en las que se hayan inscrito. Accede a tus conversaciones activas desde la sección de chats."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Mi perfil -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mi perfil"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Consulta y edita tus datos personales, como nombre, mail, dirección y teléfonos. También puedes revisar tus valoraciones y acceder a funciones como cambiar de rol o desactivar tu cuenta."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cambiar a proveedor -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Convertirme en proveedor"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Si deseas ofrecer servicios además de buscar, puedes convertirte en proveedor. Completa los datos requeridos y pasarás a tener acceso a funciones específicas como gestionar servicios y responder a ofertas."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Desactivar cuenta -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False" MaximumWidthRequest="800">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Desactivar mi cuenta"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Puedes desactivar tu cuenta si ya no deseas usar la plataforma. Esto ocultará tu perfil y todas tus publicaciones, sin eliminar los datos definitivamente."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
