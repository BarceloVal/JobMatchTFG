<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Job_Match.Maui.Views.LoginPage">

    <Grid BackgroundColor="White" RowDefinitions="*,Auto">

        <!-- Contenido principal -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>

                <!-- Forma decorativa roja -->
                <Grid HeightRequest="220">
                    <!-- Decoración para Android -->
                    <Path x:Name="PathAndroid"
                          Stroke="#000"
                          Fill="#980c0f"
                          IsVisible="False"
                          Data="m202.59145,194.89999c-123.48078,0 -225.59145,-67.52315 -225.59145,-148.85743c0,-81.33428 100.01943,-154.14258 223.50023,-154.14258c123.48078,0 222.55917,74.72198 223.50023,154.14258c0.94106,79.42059 -97.92821,148.85743 -221.40899,148.85743l-0.00001,0z"/>

                    <!-- Decoración para Window -->
                    <ContentView HorizontalOptions="Center" IsVisible="{OnPlatform Android=false, WinUI=true}">
                        <Path x:Name="PathWin"
                              Stroke="#000"
                              Fill="#980c0f"
                              Data="m307.33873,188.90004c-167.67898,0 -306.3387,-93.15076 -306.3387,-205.3545c0,-112.20375 135.81997,-212.64558 303.49896,-212.64558c167.67898,0 302.22106,103.08183 303.49896,212.64558c1.27789,109.56373 -132.98022,205.3545 -300.6592,205.3545l-0.00002,0l-0.00002,0l0.00002,0l0.00001,0z" />
                    </ContentView>
                    <Image
                        Source="jobmatchwhite.png"
                        HeightRequest="130"
                        WidthRequest="130"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Margin="0, 0, 0, 45"/>
                </Grid>

                <!-- Título -->
                <Label
                    Text="¡Bienvenido!"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    FontSize="35"
                    FontAttributes="Bold"
                    Margin="0, 20, 0, 0"/>

                <!-- Subtítulo -->
                <Label
                    Text="Inicia sesión para continuar"
                    HorizontalOptions="Center"
                    FontSize="20"
                    Margin="0, 0, 0, 20"/>

                <!-- Campos de entrada de datos -->
                <StackLayout Margin="30, 10, 30, 10">

                    <!-- Usuario/Mail -->
                    <Frame
                        BackgroundColor="Transparent"
                        BorderColor="Black"
                        Padding="10,0"
                        CornerRadius="30"
                        HasShadow="False"
                        MaximumWidthRequest="500">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <!-- Ícono -->
                            <Image
                                Source="mail.png"
                                WidthRequest="28"
                                HeightRequest="28"
                                VerticalOptions="Center"
                                Margin="5,0"/>
                            <!-- Entrada de datos -->
                            <Entry
                                x:Name="eMail"
                                Text="{Binding Mail}"
                                Grid.Column="1"
                                Keyboard="Email"
                                Placeholder="Introduce tu mail"
                                TextColor="Black"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Center"
                                Margin="10,0" />

                        </Grid>
                    </Frame>

                    <!-- Mensaje de error -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          MaximumWidthRequest="500"
                          Margin="30,0,30,0">
                        <Label Grid.Column="1"
                               Text="{Binding MailError}"
                               TextColor="Red"
                               FontSize="13"
                               Padding="0"
                               Margin="0,5,0,5"
                               IsVisible="{Binding IsMailValid, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>

                    <!-- Contraseña -->
                    <Frame
                        BackgroundColor="Transparent"
                        BorderColor="Black"
                        Padding="10,0"
                        CornerRadius="30"
                        HasShadow="False"
                        Margin="0,10,0,0"
                        MaximumWidthRequest="500">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <!-- Ícono -->
                            <Image
                                Source="password.png"
                                WidthRequest="28"
                                VerticalOptions="Center"
                                Margin="5,0"/>
                            <!-- Entrada de datos -->
                            <Entry
                                x:Name="ePassword"
                                Text="{Binding Password}"
                                IsPassword="True"
                                Grid.Column="1"
                                Placeholder="Introduce tu contraseña"
                                TextColor="Black"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                HorizontalOptions="FillAndExpand"
                                Margin="10,0"/>
                            <!-- Ojito (visibilidad de la contraseña) -->
                            <ImageButton
                                x:Name="btnPasswordVisibility"
                                Source="passwordoff.png"
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="Transparent"
                                Clicked="btnPasswordVisibility_Clicked"
                                Grid.Column="2"
                                VerticalOptions="Center"
                                Margin="5,0"/>
                        </Grid>
                    </Frame>

                    <!-- Mensaje de error -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          MaximumWidthRequest="500"
                          Margin="30,0,30,0">
                        <Label Grid.Column="1"
                               Text="{Binding PasswordError}"
                               TextColor="Red"
                               FontSize="13"
                               Padding="0"
                               Margin="0,5,0,5"
                               IsVisible="{Binding IsPasswordValid, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>

                </StackLayout>

                <!-- Recordar contraseña -->
                <StackLayout MaximumWidthRequest="500" Orientation="Horizontal"  Margin="30, 10, 30, 10" Padding="0">
                    <CheckBox IsChecked="False" />
                    <Label Text="Recuerdame la contraseña" TextColor="Black" FontSize="15" VerticalTextAlignment="Center" />
                </StackLayout>

                <!-- Botón iniciar sesión -->
                <Button
                    x:Name="btnSesion"
                    Text="Iniciar sesión"
                    BackgroundColor="#980c0f"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="30"
                    WidthRequest="330"
                    Margin="30, 10, 30, 10"
                    Clicked="btnSesion_Clicked"
                    MaximumWidthRequest="500"/>

                <!-- Link crear cuenta -->
                <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand" Margin="0, 30, 0, 0">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    Text="¿Eres nuevo/a? "
                                    TextColor="Black"
                                    FontSize="15"/>
                                <Span
                                    Text="Créate una cuenta"
                                    TextColor="Blue"
                                    FontAttributes="Bold"
                                    FontSize="15">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </StackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer fijo abajo -->
        <StackLayout Grid.Row="1" Padding="0,10" Margin="0, 0, 0, 20" Spacing="2">
            <Label Text="© 2025 JobMatch. Todos los derechos reservados."
                   TextColor="Black"
                   FontSize="14"
                   HorizontalTextAlignment="Center"/>
            <Label Text="Terms of Service | Privacy Policy"
                   TextColor="Black"
                   FontSize="14"
                   HorizontalTextAlignment="Center"/>
        </StackLayout>
    </Grid>
</ContentPage>
