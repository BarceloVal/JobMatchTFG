<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             xmlns:conv="clr-namespace:Job_Match.Maui.Converters"
             x:Class="Job_Match.Maui.Views.ScoreUser"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto" Padding="0">

        <!-- Encabezado personalizado -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="#980c0f"
            HeightRequest="50"
            VerticalOptions="Start">

            <!-- Flecha de volver -->
            <ImageButton
                x:Name="btnBack"
                Source="arrowback.png"
                Clicked="btnBack_Clicked"
                WidthRequest="35"
                HeightRequest="35"
                Margin="10, 0, 0, 0"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Grid.Column="0" />

            <!-- Nombre del proveedor centrado en el espacio disponible -->
            <Label
                Text="{Binding DisplayName}"
                Grid.Column="1"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="White"
                FontSize="20"
                FontAttributes="Bold"/>

            <!-- Caja invisible para equilibrar el ancho -->
            <ContentView Grid.Column="2" WidthRequest="55" />
        </Grid>

        <!-- Título -->
        <Label
            Grid.Row="1"
            Text="Valorar usuario"
            FontSize="25"
            FontAttributes="Bold"
            Margin="0, 20, 0, 10"
            HorizontalOptions="Center"/>

        <!-- Estrellas -->
        <HorizontalStackLayout Grid.Row="2" Margin="0, 20, 0, 20" Spacing="5" HorizontalOptions="Center">
            <ImageButton x:Name="btnStar1" Source="starempty.png" Clicked="btnStar1_Clicked" />
            <ImageButton x:Name="btnStar2" Source="starempty.png" Clicked="btnStar2_Clicked" />
            <ImageButton x:Name="btnStar3" Source="starempty.png" Clicked="btnStar3_Clicked" />
            <ImageButton x:Name="btnStar4" Source="starempty.png" Clicked="btnStar4_Clicked" />
            <ImageButton x:Name="btnStar5" Source="starempty.png" Clicked="btnStar5_Clicked" />
        </HorizontalStackLayout>

    </Grid>

</ContentPage>