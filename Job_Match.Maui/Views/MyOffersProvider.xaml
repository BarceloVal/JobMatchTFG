<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.MyOffersProvider"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto">

        <!-- ENCABEZADO PERSONALIZADO -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="#980c0f"
            HeightRequest="50"
            VerticalOptions="Start">

            <!-- Flecha de volver -->
            <ImageButton
                x:Name="btnBack"
                Source="arrowback.png"
                Clicked="btnBack_Clicked"
                WidthRequest="35"
                HeightRequest="35"
                Margin="10, 0, 0, 0"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Grid.Column="0" />

            <!-- Nombre del proveedor centrado en el espacio disponible -->
            <Label
                Text="Mis ofertas inscritas"
                Grid.Column="1"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="White"
                FontSize="20"
                FontAttributes="Bold"/>

            <!-- Caja invisible para equilibrar el ancho -->
            <ContentView Grid.Column="2" WidthRequest="55" />
        </Grid>

        <!-- Contenido con scroll -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20">
                <CollectionView ItemsSource="{Binding MyOffers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" BorderColor="#ccc" CornerRadius="10">
                                <VerticalStackLayout>

                                    <!-- Título -->
                                    <HorizontalStackLayout>
                                        <Label
                                            Text="{Binding Title}"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            TextColor="#980c0f"/>
                                    </HorizontalStackLayout>

                                    <!-- Código postal -->
                                    <Label
                                        Text="{Binding PostalCodeName}"
                                        FontSize="14"
                                        Margin="0, 10, 0, 0"/>

                                    <!-- Descripción -->
                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="14"
                                        FontAttributes="Italic"
                                        LineBreakMode="WordWrap"
                                        Margin="0, 10, 10, 10"/>

                                    <!-- Fechas -->
                                    <Label Text="{Binding DateStart, StringFormat='Desde: {0:dd/MM/yyyy}'}" FontSize="14"/>
                                    <Label Text="{Binding DateEnd, StringFormat='Hasta: {0:dd/MM/yyyy}'}" FontSize="14"/>

                                    <!-- Estado de la tarea -->
                                    <Label Text="{Binding Status}"
                                           FontSize="14"
                                           TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                           Margin="0, 10, 0, 5"/>

                                    <!-- Botón para salirse de la oferta -->
                                    <Button
                                        x:Name="btnQuitOffer"
                                        Text="Quitarse de la oferta"
                                        BackgroundColor="#980c0f"
                                        Margin="0, 10, 0, 5"
                                        Clicked="btnQuitOffer_Clicked"
                                        CommandParameter="{Binding}"/>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>