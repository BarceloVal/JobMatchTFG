<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.MyOffersProvider"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout>

        <!-- Mi encabezado personalizado -->
        <controls:HeaderControl />

        <!-- Contenido con scroll -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20">

                <!-- BLOQUE DE FILTROS -->
                <Frame BorderColor="Black"
                       CornerRadius="10"
                       Padding="10"
                       Margin="0, 0, 0, 15"
                       HasShadow="False"
                       MaximumWidthRequest="600">
                    <VerticalStackLayout Spacing="15">

                        <!-- Población -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker Title="Estado de la oferta"
                                    ItemsSource="{Binding TaskStatuses}"
                                    SelectedItem="{Binding SelectedTaskStatus}"
                                    ItemDisplayBinding="{Binding Name}" />
                            <Image x:Name="imgArrowState"
                                   Source="arrowdown.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   HorizontalOptions="End"
                                   Margin="0,0,10,10"/>
                        </Grid>

                        <!-- Botones -->
                        <HorizontalStackLayout Spacing="15"
                                               HorizontalOptions="Center"
                                               Margin="0,10">
                            <Button x:Name="btnClean"
                                    Text="Limpiar filtros"
                                    BackgroundColor="#980c0f"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    WidthRequest="150"
                                    FontAttributes="Bold"
                                    Clicked="btnClean_Clicked"/>

                            <Button x:Name="btnSearch"
                                    Text="Buscar"
                                    BackgroundColor="#980c0f"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    WidthRequest="150"
                                    FontAttributes="Bold"
                                    Clicked="btnSearch_Clicked"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Lista de ofertas -->
                <CollectionView ItemsSource="{Binding MyOffers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="0, 0, 0, 10" BorderColor="#ccc" CornerRadius="10" MaximumWidthRequest="600">
                                <VerticalStackLayout>

                                    <!-- Título -->
                                    <HorizontalStackLayout>
                                        <Label
                                            Text="{Binding Title}"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            TextColor="#980c0f"/>
                                    </HorizontalStackLayout>

                                    <!-- Código postal -->
                                    <Label
                                        Text="{Binding PostalCodeName}"
                                        FontSize="14"
                                        Margin="0, 10, 0, 0"/>

                                    <!-- Descripción -->
                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="14"
                                        FontAttributes="Italic"
                                        LineBreakMode="WordWrap"
                                        Margin="0, 10, 10, 10"/>

                                    <!-- Fechas -->
                                    <Label Text="{Binding DateStart, StringFormat='Desde: {0:dd/MM/yyyy}'}" FontSize="14"/>
                                    <Label Text="{Binding DateEnd, StringFormat='Hasta: {0:dd/MM/yyyy}'}" FontSize="14"/>

                                    <!-- Estado de la tarea -->
                                    <Label Text="{Binding Status}"
                                           FontSize="14"
                                           TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                           Margin="0, 10, 0, 5"/>

                                    <!-- Botón para salirse de la oferta -->
                                    <Button
                                        x:Name="btnQuitOffer"
                                        Text="Quitarse de la oferta"
                                        TextColor="white"
                                        BackgroundColor="#980c0f"
                                        Margin="0, 10, 0, 5"
                                        Clicked="btnQuitOffer_Clicked"
                                        CommandParameter="{Binding}"/>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>