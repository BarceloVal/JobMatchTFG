<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.MyOffersProvider"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <!-- Mi encabezado personalizado -->
            <controls:HeaderControl />
        </VerticalStackLayout>

        <!-- Contenido con scroll -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20">
                <Label Text="Mis ofertas inscritas"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#980c0f"
                       HorizontalOptions="Center"/>

                <CollectionView ItemsSource="{Binding MyOffers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" BorderColor="#ccc" CornerRadius="10">
                                <VerticalStackLayout>

                                    <!-- Título -->
                                    <HorizontalStackLayout>
                                        <Label
                                            Text="{Binding Title}"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            TextColor="#980c0f"/>
                                    </HorizontalStackLayout>

                                    <!-- Código postal -->
                                    <Label
                                        Text="{Binding PostalCodeName}"
                                        FontSize="14"
                                        Margin="0, 10, 0, 0"/>

                                    <!-- Descripción -->
                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="14"
                                        FontAttributes="Italic"
                                        LineBreakMode="WordWrap"
                                        Margin="0, 10, 10, 10"/>

                                    <!-- Fechas -->
                                    <Label Text="{Binding DateStart, StringFormat='Desde: {0:dd/MM/yyyy}'}" FontSize="14"/>
                                    <Label Text="{Binding DateEnd, StringFormat='Hasta: {0:dd/MM/yyyy}'}" FontSize="14"/>

                                    <!-- Estado de la tarea -->
                                    <Label Text="{Binding Status}"
                                           FontSize="14"
                                           TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                           Margin="0, 10, 0, 5"/>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Línea separadora -->
        <BoxView
            Grid.Row="2"
            HeightRequest="1"
            BackgroundColor="#980c0f"
            Margin="0, 10, 0, 10"
            HorizontalOptions="FillAndExpand" />

        <!-- Botón Volver -->
        <Button
            Grid.Row="3"
            x:Name="btnBackToMenuProvider"
            Text="Volver"
            BackgroundColor="#980c0f"
            TextColor="White"
            CornerRadius="10"
            FontAttributes="Bold"
            FontSize="18"
            HeightRequest="45"
            WidthRequest="350"
            HorizontalOptions="Center"
            Margin="0,5,0,20"
            Clicked="btnBackToMenuProvider_Clicked" />
    </Grid>
</ContentPage>