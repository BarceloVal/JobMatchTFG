<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Job_Match.Maui.Views.CreateProviderAccount"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Capa 1: el Path rojo -->
        <Grid HeightRequest="150">
            <!-- Decoración para Android -->
            <Path x:Name="PathAndroid"
                  Stroke="#000"
                  Fill="#980c0f"
                  IsVisible="False"
                  Data="m201.48868,122.90001c-117.40352,0 -214.48868,-62.39763 -214.48868,-137.55803c0,-75.1604 95.09685,-142.442 212.50038,-142.442c117.40352,0 211.60564,69.05002 212.50038,142.442c0.89474,73.39197 -93.10855,137.55803 -210.51207,137.55803z" />

            <!-- Decoración para Window -->
            <ContentView HorizontalOptions="Center" IsVisible="{OnPlatform Android=false, WinUI=true}">
                <Path x:Name="PathWin"
                      Stroke="#000"
                      Fill="#980c0f"
                      Data="m307.33873,148.90004c-167.67898,0 -306.3387,-93.15076 -306.3387,-205.3545c0,-112.20375 135.81997,-212.64558 303.49896,-212.64558c167.67898,0 302.22106,103.08183 303.49896,212.64558c1.27789,109.56373 -132.98022,205.3545 -300.6592,205.3545l-0.00002,0l-0.00002,0l0.00002,0l0.00001,0z" />
            </ContentView>
            <Image
                Source="jobmatchwhite.png"
                HeightRequest="100"
                WidthRequest="100"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                TranslationY="10"/>
        </Grid>

        <!-- Título -->
        <StackLayout Grid.Row="1" Padding="0">
            <Label
                Text="Créate una cuenta"
                TextColor="Black"
                FontSize="35"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Proveedor"
                TextColor="Black"
                FontSize="20"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"/>
        </StackLayout>

        <!-- Cuerpo/Formulario -->
        <ScrollView Grid.Row="2" Margin="20, 40, 20, 20">
            <Frame
                Padding="20"
                CornerRadius="30"
                BorderColor="Black"
                HasShadow="False"
                BackgroundColor="White"
                MaximumWidthRequest="600">

                <!-- Campos -->
                <VerticalStackLayout>
                    <!-- Nombre-->
                    <HorizontalStackLayout>
                        <Label
                            Text="Nombre"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding FirstName}"
                        TextColor="Black"
                        Placeholder="Introduce tu nombre"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsFirstNameValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding FirstNameError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsFirstNameValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Apellido-->
                    <HorizontalStackLayout>
                        <Label
                            Text="Apellido"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding LastName}"
                        TextColor="Black"
                        Placeholder="Introduce tu apellido"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsLastNameValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding LastNameError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsLastNameValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Nombre comercial -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Nombre comercial"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding TradeName}"
                        TextColor="Black"
                        Placeholder="Introduce tu nombre comercial"
                        BackgroundColor="Transparent" >
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsTradeNameValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding TradeNameError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsTradeNameValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Mail/Usuario -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Mail"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Mail}"
                        TextColor="Black"
                        Keyboard="Email"
                        Placeholder="Introduce tu mail"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsMailValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding MailError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsMailValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Contraseña -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Contraseña"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">

                        <Entry
                            x:Name="ePasswordProvider1"
                            Text="{Binding Password}"
                            TextColor="Black"
                            IsPassword="True"
                            Placeholder="Introduce contraseña"
                            BackgroundColor="Transparent" />
                        <ImageButton
                            x:Name="btnPasswordVisibility1"
                            Source="passwordoff.png"
                            WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="Transparent"
                            HorizontalOptions="End"
                            Margin="5"
                            Clicked="btnPasswordVisibility1_Clicked" />
                    </Grid>
                    <Label
                        Text="{Binding PasswordError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsPasswordValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Repetir contraseña -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Repetir contraseña"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">

                        <Entry
                            x:Name="ePasswordProvider2"
                            Text="{Binding RepeatPassword}"
                            TextColor="Black"
                            IsPassword="True"
                            Placeholder="Introduce contraseña nuevamente"
                            BackgroundColor="Transparent" />
                        <ImageButton
                            x:Name="btnPasswordVisibility2"
                            Source="passwordoff.png"
                            WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="Transparent"
                            HorizontalOptions="End"
                            Margin="5"
                            Clicked="btnPasswordVisibility2_Clicked" />
                    </Grid>
                    <Label
                        Text="{Binding RepeatPasswordError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsRepeatPasswordValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Tipo de documento -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Tipo de documento"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">

                        <Picker
                            ItemsSource="{Binding DocTypes}"
                            ItemDisplayBinding="{Binding name}"
                            SelectedItem="{Binding SelectedDocType}" />

                        <!-- Flecha decorativa -->
                        <Image Source="arrowdown.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="End"
                               Margin="0,0,10,10"/>
                    </Grid>

                    <!-- Documento -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Documento"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Document}"
                        TextColor="Black"
                        Placeholder="Introduce tu documento"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsDocumentValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding DocumentError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsDocumentValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- WebSite -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Website"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Website}"
                        TextColor="Black"
                        Placeholder="Introduce tu website"
                        BackgroundColor="Transparent" >
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsWebsiteValid}"
                                Value="True">
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding WebsiteError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsWebsiteValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Dirección -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Dirección"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Address}"
                        Placeholder="Introduce tu dirección"
                        BackgroundColor="Transparent"
                        TextColor="Black"/>
                    <Label
                        Text="{Binding AddressError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsAddressValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- MapCoordenates -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Coordenadas del mapa"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding MapCoordinates}"
                        TextColor="Black"
                        Placeholder="Introduce las coordenadas de tu dirección"
                        BackgroundColor="Transparent">
                        <Entry.Triggers>
                            <DataTrigger
                                TargetType="Entry"
                                Binding="{Binding IsMapCoordinatesValid}"
                                Value="False">
                                <Setter Property="TextColor" Value="Red"/>
                            </DataTrigger>
                        </Entry.Triggers>
                    </Entry>
                    <Label
                        Text="{Binding MapCoordinatesError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding HasMapCoordinatesError}" />

                    <!-- Código postal -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Población"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Picker
                            ItemsSource="{Binding PostalCodes}"
                            SelectedItem="{Binding SelectedPostalCode}"
                            ItemDisplayBinding="{Binding DisplayText}"/>

                        <!-- Flecha decorativa -->
                        <!--<Image Source="arrowdown.png"
                        HeightRequest="20"
                        WidthRequest="20"
                        HorizontalOptions="End"
                        Margin="0,0,10,10"/>-->
                    </Grid>

                    <!-- Tipo de servicio -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Tipo de servicio"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Picker
                        ItemsSource="{Binding ServiceTypes}"
                        ItemDisplayBinding="{Binding name}"
                        SelectedItem="{Binding SelectedServiceType}" />

                    <!-- Servicio -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Servicio"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding FilteredServices}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Padding="10,0">
                                    <RadioButton
                                        x:Name="radBtnServices"
                                        GroupName="ServicesGroup"
                                        Content="{Binding name}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        CheckedChanged="radBtnServices_CheckedChanged"/>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Descripción -->
                    <Label
                        Text="Descripción"
                        TextColor="Black"
                        FontSize="15"
                        Margin="0, 20, 0, 10"/>

                    <Frame
                        BorderColor="Black"
                        CornerRadius="10"
                        Padding="10"
                        HasShadow="False"
                        BackgroundColor="Transparent"
                        HeightRequest="100"
                        VerticalOptions="Start">

                        <Editor
                            x:Name="eDescription"
                            Text="{Binding Description}"
                            Placeholder="Escribe una breve descripción sobre tus servicios"
                            TextColor="Black"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            FontSize="15"
                            TextChanged="eDescription_TextChanged_1"/>
                    </Frame>

                    <!-- Contador de caracteres -->
                    <Label
                        x:Name="lblCharCount"
                        Text="0/1000"
                        FontSize="13"
                        TextColor="Gray"
                        HorizontalOptions="End"
                        Margin="0,5,5,0"/>

                    <Label
                        Text="{Binding DescriptionError}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsDescriptionValid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Teléfono 1 -->
                    <HorizontalStackLayout>
                        <Label
                            Text="Teléfono 1"
                            TextColor="Black"
                            FontSize="15"
                            Margin="0, 20, 0, 0"/>
                        <Label
                            Text="*"
                            TextColor="Red"
                            FontSize="15"
                            Margin="8, 22, 0, 0"/>
                    </HorizontalStackLayout>
                    <Entry
                        Text="{Binding Phone1}"
                        Placeholder="Introduce tu teléfono"
                        Keyboard="Telephone"
                        BackgroundColor="Transparent"
                        TextColor="Black"/>
                    <Label
                        Text="{Binding Phone1Error}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsPhone1Valid, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Teléfono 2 -->
                    <Label
                        Text="Teléfono 2"
                        TextColor="Black"
                        FontSize="15"
                        Margin="0, 20, 0, 0"/>
                    <Entry
                        Text="{Binding Phone2}"
                        Placeholder="Introduce otro teléfono (opcional)"
                        Keyboard="Telephone"
                        BackgroundColor="Transparent"
                        TextColor="Black"/>
                    <Label
                        Text="{Binding Phone2Error}"
                        TextColor="Red"
                        FontSize="13"
                        IsVisible="{Binding IsPhone2Valid, Converter={StaticResource InverseBoolConverter}}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>

        <Button
            Grid.Row="3"
            x:Name="btnCreateProvider"
            Text="Crear cuenta"
            BackgroundColor="#980c0f"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="18"
            CornerRadius="10"
            WidthRequest="350"
            Margin="0, 10, 0, 20"
            Clicked="btnCreateProvider_Clicked"/>

    </Grid>

</ContentPage>