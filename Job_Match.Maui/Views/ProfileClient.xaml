<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Job_Match.Maui.Views.ProfileClient"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f4f4f6">

    <ScrollView>
        <VerticalStackLayout Spacing="25" HorizontalOptions="Center">

            <!-- Encabezado personalizado -->
            <controls:HeaderControl />

            <!-- Nombre completo -->
            <Label Text="{Binding FullName}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#980c0f"
                   HorizontalOptions="Center" />

            <!-- Datos del perfil -->
            <VerticalStackLayout Spacing="6" Padding="20">
                <Label FormattedText="{x:StaticResource NombreFormattedText}" />
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Nombre: " FontAttributes="Bold"/>
                            <Span Text="{Binding FirstName}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Apellido/s: " FontAttributes="Bold" />
                            <Span Text="{Binding LastName}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Mail: " FontAttributes="Bold" />
                            <Span Text="{Binding Mail}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Documento: " FontAttributes="Bold" />
                            <Span Text="{Binding Document}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Dirección: " FontAttributes="Bold" />
                            <Span Text="{Binding Address}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Código Postal: " FontAttributes="Bold" />
                            <Span Text="{Binding PostalCodeName}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Teléfono 1: " FontAttributes="Bold" />
                            <Span Text="{Binding Phone1}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Teléfono 2: " FontAttributes="Bold" />
                            <Span Text="{Binding Phone2}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- Botón para cambiar de perfil -->
            <Button
                x:Name="btnSwitchUser"
                Text="Cambiar perfil a proveedor"
                BackgroundColor="#980c0f"
                TextColor="White"
                CornerRadius="20"
                FontAttributes="Bold"
                Padding="14,10"
                WidthRequest="250"
                HorizontalOptions="Center"
                Clicked="btnSwitchUser_Clicked"/>

            <!-- Botón para editar el perfil -->
            <Button
                x:Name="btnEditProfileClient"
                Text="Editar perfil"
                BackgroundColor="#980c0f"
                TextColor="White"
                CornerRadius="20"
                FontAttributes="Bold"
                Padding="14,10"
                WidthRequest="250"
                HorizontalOptions="Center"
                Clicked="btnEditProfileClient_Clicked"/>

            <!-- Botón para deshabilitar la cuenta -->
            <Button
                x:Name="btnDisableAccount"
                Text="Deshabilitar cuenta"
                BackgroundColor="#980c0f"
                TextColor="White"
                CornerRadius="20"
                FontAttributes="Bold"
                Padding="14,10"
                WidthRequest="250"
                HorizontalOptions="Center"
                Clicked="btnDisableAccount_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
