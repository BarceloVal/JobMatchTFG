<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.OfferProvider"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Mi encabezado personalizado -->
        <controls:HeaderControl Grid.Row="0" />

        <!-- Cuerpo -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Título -->
                <Label
                    Text="Buscar ofertas abiertas"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="0, 10, 0, 10"/>

                <Frame
                    BorderColor="Black"
                    CornerRadius="10"
                    Padding="10"
                    HasShadow="False"
                    MaximumWidthRequest="600">
                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Población -->
                            <Picker
                                Title="Población"
                                ItemsSource="{Binding PostalCodes}"
                                SelectedItem="{Binding SelectedPostalCode}"
                                ItemDisplayBinding="{Binding DisplayText}" />
                            <Image
                                x:Name="imgArrowPostalCode"
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"/>
                        </Grid>

                        <!-- Tipo de servicio -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Tipo de servicio"
                                ItemsSource="{Binding ServiceTypes}"
                                SelectedItem="{Binding SelectedServiceType}"
                                ItemDisplayBinding="{Binding name}" />
                            <Image
                                x:Name="imgArrowServiceType"
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"/>
                        </Grid>

                        <!-- Servicio -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Servicio"
                                ItemsSource="{Binding FilteredServices}"
                                SelectedItem="{Binding SelectedService}"
                                ItemDisplayBinding="{Binding name}" />
                            <Image
                                x:Name="imgArrowService"
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"/>
                        </Grid>

                        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10">

                            <!-- Botón de limpiar filtros -->
                            <Button
                                x:Name="btnClean"
                                Text="Limpiar filtros"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="45"
                                WidthRequest="150"
                                FontAttributes="Bold"
                                Clicked="btnClean_Clicked" />

                            <!-- Botón de buscar -->
                            <Button
                                x:Name="btnSearch"
                                Text="Buscar"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="45"
                                WidthRequest="150"
                                FontAttributes="Bold"
                                Clicked="btnSearch_Clicked" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Lista de resultados con scroll completo -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding OpenOffers}" Margin="20,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Black" CornerRadius="10" Padding="10" Margin="0,10" MaximumWidthRequest="600">
                        <VerticalStackLayout Spacing="8">

                            <!-- Título en rojo -->
                            <Label Text="{Binding Title}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#980c0f" />

                            <!-- Subtítulo: Cliente -->
                            <Label Text="{Binding ClientName}"
                                   TextColor="Black"
                                   FontSize="14"
                                   FontAttributes="Italic" />

                            <!-- Tipo de servicio -->
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Tipo de servicio: " TextColor="Black" FontAttributes="Bold"/>
                                        <Span Text="{Binding ServiceTypeName}" TextColor="Black"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Servicio -->
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Servicio: " TextColor="Black" FontAttributes="Bold"/>
                                        <Span Text="{Binding ServiceName}" TextColor="Black"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Código postal -->
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Población: " TextColor="Black" FontAttributes="Bold"/>
                                        <Span Text="{Binding PostalCodeName}" TextColor="Black"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Descripción -->
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Descripción: " TextColor="Black" FontAttributes="Bold"/>
                                        <Span Text="{Binding Description}" TextColor="Black"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Estado -->
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Estado: " TextColor="Black" FontAttributes="Bold"/>
                                        <Span Text="{Binding Status}" TextColor="Black" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Botón de inscripción -->
                            <Button
                                Text="Inscribirse"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="btnSubscribeOffer_Clicked"
                                CommandParameter="{Binding}"/>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>