<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.ProfileProvider"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="25" HorizontalOptions="Center">

            <!-- Encabezado personalizado -->
            <controls:HeaderControl />

            <!-- Nombre completo -->
            <Label
                Text="{Binding FullName}"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#980c0f"
                HorizontalOptions="Center" />

            <!-- Datos del perfil -->
            <VerticalStackLayout Spacing="10" Padding="20">

                <!-- Grupo de datos personales -->
                <Frame BackgroundColor="#f5f5f5" Padding="10" CornerRadius="8" HasShadow="False" MaximumWidthRequest="600">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Datos personales" TextColor="#980c0f" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Margin="5"/>

                        <!-- Nombre -->
                        <HorizontalStackLayout>
                            <Label Text="Nombre: " FontAttributes="Bold" />
                            <Label Text="{Binding FirstName}" />
                        </HorizontalStackLayout>

                        <!-- Apellido -->
                        <HorizontalStackLayout>
                            <Label Text="Apellido: " FontAttributes="Bold" />
                            <Label Text="{Binding LastName}" />
                        </HorizontalStackLayout>

                        <!-- Documento -->
                        <HorizontalStackLayout>
                            <Label Text="Documento: " FontAttributes="Bold" />
                            <Label Text="{Binding Document}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Contacto y ubicación -->
                <Frame BackgroundColor="#f5f5f5" Padding="10" CornerRadius="8" HasShadow="False" MaximumWidthRequest="600">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Datos de perfil" TextColor="#980c0f" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Margin="5"/>

                        <!-- Nombre comercial -->
                        <HorizontalStackLayout>
                            <Label Text="Nombre comercial: " FontAttributes="Bold" />
                            <Label Text="{Binding TradeName}" />
                        </HorizontalStackLayout>

                        <!-- Mail -->
                        <HorizontalStackLayout>
                            <Label Text="Mail: " FontAttributes="Bold" />
                            <Label Text="{Binding Mail}" />
                        </HorizontalStackLayout>

                        <!-- WebSite -->
                        <HorizontalStackLayout>
                            <Label Text="Website: " FontAttributes="Bold" />
                            <Label Text="{Binding Website}" />
                        </HorizontalStackLayout>

                        <!-- Dirección -->
                        <HorizontalStackLayout>
                            <Label Text="Dirección: " FontAttributes="Bold" />
                            <Label Text="{Binding Address}" />
                        </HorizontalStackLayout>

                        <!-- Código postal -->
                        <HorizontalStackLayout>
                            <Label Text="Pobl.: " FontAttributes="Bold" />
                            <Label Text="{Binding PostalCodeName}" />
                        </HorizontalStackLayout>

                        <!-- Teléfono 1 -->
                        <HorizontalStackLayout>
                            <Label Text="Teléfono 1: " FontAttributes="Bold" />
                            <Label Text="{Binding Phone1}" />
                        </HorizontalStackLayout>

                        <!-- Teléfono 2 -->
                        <HorizontalStackLayout>
                            <Label Text="Teléfono 2: " FontAttributes="Bold" />
                            <Label Text="{Binding Phone2}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Servicio -->
                <Frame BackgroundColor="#f5f5f5" Padding="10" CornerRadius="8" HasShadow="False" MaximumWidthRequest="600">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Servicios ofrecidos" TextColor="#980c0f" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Margin="5"/>
                        <Label Text="Descripción" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" LineBreakMode="WordWrap"/>
                        <CollectionView ItemsSource="{Binding Services}" Margin="0,10,0,20">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout>
                                        <HorizontalStackLayout>
                                            <Label Text="Tipo de servicio: " FontAttributes="Bold"/>
                                            <Label Text="{Binding ServiceTypeName}"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout>
                                            <Label Text="Servicio: " FontAttributes="Bold"/>
                                            <Label Text="{Binding ServiceName}" />
                                        </HorizontalStackLayout>

                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Valoraciones recibidas" FontAttributes="Bold" FontSize="18" TextColor="#980c0f" Margin="0,20,0,5" HorizontalTextAlignment="Center"/>
                <CollectionView ItemsSource="{Binding ReceivedScores}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="#ccc" CornerRadius="8" Padding="10" Margin="0,5" MaximumWidthRequest="600">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding ReviewerName}" FontAttributes="Bold" FontSize="14"/>
                                    <Label Text="{Binding Rating, StringFormat='⭐ {0}'}" TextColor="#980c0f"/>
                                    <Label Text="{Binding Comment}" FontSize="13" LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding CreatedOn, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" TextColor="Gray" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

            <!-- Botón para cambiar de perfil -->
            <Button
                x:Name="btnSwitchUser"
                Text="Cambiar perfil a cliente"
                BackgroundColor="#980c0f"
                TextColor="White"
                CornerRadius="10"
                FontAttributes="Bold"
                Padding="14,10"
                WidthRequest="350"
                HorizontalOptions="Center"
                Clicked="btnSwitchUser_Clicked"/>

            <!-- Botón para editar el perfil -->
            <Button
                x:Name="btnEditProfile"
                Text="Editar perfil"
                BackgroundColor="#980c0f"
                TextColor="White"
                CornerRadius="10"
                FontAttributes="Bold"
                Padding="14,10"
                WidthRequest="350"
                HorizontalOptions="Center"
                Clicked="btnEditProfile_Clicked"/>

            <!-- Botón para deshabilitar la cuenta -->
            <Button
                x:Name="btnDisableAccount"
                Text="Deshabilitar cuenta"
                BackgroundColor="#980c0f"
                TextColor="White"
                CornerRadius="10"
                FontAttributes="Bold"
                Padding="14,10"
                Margin="0, 0, 0, 30"
                WidthRequest="350"
                HorizontalOptions="Center"
                Clicked="btnDisableAccount_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
