<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.ProfileProvider"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <controls:HeaderControl />

            <VerticalStackLayout Padding="20" Spacing="10">

                <Label Text="{Binding FullName}" FontSize="25" TextColor="#980c0f" HorizontalOptions="Center" FontAttributes="Bold" />

                <Grid ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Etiquetas -->
                    <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="0" Text="Nombre comercial:" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="0" Text="Mail:" FontAttributes="Bold" />
                    <Label Grid.Row="4" Grid.Column="0" Text="Documento:" FontAttributes="Bold" />
                    <Label Grid.Row="5" Grid.Column="0" Text="Website:" FontAttributes="Bold" />
                    <Label Grid.Row="6" Grid.Column="0" Text="Dirección:" FontAttributes="Bold" />
                    <Label Grid.Row="7" Grid.Column="0" Text="Código Postal:" FontAttributes="Bold" />
                    <Label Grid.Row="8" Grid.Column="0" Text="Teléfono 1:" FontAttributes="Bold" />
                    <Label Grid.Row="9" Grid.Column="0" Text="Teléfono 2:" FontAttributes="Bold" />
                    <Label Grid.Row="10" Grid.Column="0" Text="Descripción:" FontAttributes="Bold" />

                    <!-- Valores -->
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding FirstName}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding LastName}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding TradeName}" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Mail}" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Document}" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding Website}" />
                    <Label Grid.Row="6" Grid.Column="1" Text="{Binding Address}" />
                    <Label Grid.Row="7" Grid.Column="1" Text="{Binding PostalCodeName}" />
                    <Label Grid.Row="8" Grid.Column="1" Text="{Binding Phone1}" />
                    <Label Grid.Row="9" Grid.Column="1" Text="{Binding Phone2}" />
                    <Label Grid.Row="10" Grid.Column="1" Text="{Binding Description}" />

                </Grid>

            </VerticalStackLayout>

            <!-- Botón para cambiar perfil -->
            <Button
                x:Name="btnSwitchUser"
                Text="Cambiar perfil a cliente"
                BackgroundColor="#980c0f"
                TextColor="White"
                CornerRadius="15"
                Padding="10"
                HorizontalOptions="Center"
                Clicked="btnSwitchUser_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
