<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             xmlns:conv="clr-namespace:Job_Match.Maui.Converters"
             x:Class="Job_Match.Maui.Views.ProfileUserScore"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto, Auto" Padding="0">

        <!-- ENCABEZADO PERSONALIZADO -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="#980c0f"
            HeightRequest="50"
            VerticalOptions="Start">

            <!-- Flecha de volver -->
            <ImageButton
                x:Name="btnBack"
                Source="arrowback.png"
                Clicked="btnBack_Clicked"
                WidthRequest="35"
                HeightRequest="35"
                Margin="10, 0, 0, 0"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Grid.Column="0" />

            <!-- Nombre del proveedor centrado en el espacio disponible -->
            <Label
                Text="{Binding DisplayName}"
                Grid.Column="1"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="White"
                FontSize="20"
                FontAttributes="Bold"/>

            <!-- Caja invisible para equilibrar el ancho -->
            <ContentView Grid.Column="2" WidthRequest="55" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="10" Padding="20">

                <Frame BackgroundColor="#f5f5f5" Padding="10" CornerRadius="8" HasShadow="False" MaximumWidthRequest="600">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Datos del usuario" TextColor="#980c0f" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Margin="5"/>

                        <!-- Mail -->
                        <HorizontalStackLayout>
                            <Label Text="Mail: " FontAttributes="Bold" />
                            <Label Text="{Binding Mail}" />
                        </HorizontalStackLayout>

                        <!-- Teléfono 1 -->
                        <HorizontalStackLayout>
                            <Label Text="Teléfono 1: " FontAttributes="Bold" />
                            <Label Text="{Binding Phone1}" />
                        </HorizontalStackLayout>

                        <!-- Teléfono 2 -->
                        <HorizontalStackLayout>
                            <Label Text="Teléfono 2: " FontAttributes="Bold" />
                            <Label Text="{Binding Phone2}" />
                        </HorizontalStackLayout>

                        <!-- Código postal -->
                        <HorizontalStackLayout>
                            <Label Text="Código Postal:" FontAttributes="Bold" />
                            <Label Text="{Binding PostalCode}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Datos que solo tiene el proveedor -->
                <Frame BackgroundColor="#f5f5f5" Padding="10" CornerRadius="8" HasShadow="False" IsVisible="{Binding IsProvider}" MaximumWidthRequest="600">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Datos del proveedor" TextColor="#980c0f" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Margin="5"/>

                        <!-- Nombre comercial -->
                        <HorizontalStackLayout>
                            <Label Text="Nombre comercial: " FontAttributes="Bold" IsVisible="{Binding TradeName, Converter={StaticResource NullToBoolConverter}}" />
                            <Label Text="{Binding TradeName}" IsVisible="{Binding TradeName, Converter={StaticResource NullToBoolConverter}}" />
                        </HorizontalStackLayout>

                        <!-- WebSite -->
                        <HorizontalStackLayout>
                            <Label Text="Sitio web: " FontAttributes="Bold" IsVisible="{Binding Website, Converter={StaticResource NullToBoolConverter}}" />
                            <Label Text="{Binding Website}" IsVisible="{Binding Website, Converter={StaticResource NullToBoolConverter}}" />
                        </HorizontalStackLayout>

                        <!-- Description -->
                        <Label Text="Descripción: " FontAttributes="Bold" IsVisible="{Binding Description, Converter={StaticResource NullToBoolConverter}}" />
                        <Label Text="{Binding Description}" LineBreakMode="WordWrap"/>

                        <!-- Tipo de servicio -->
                        <HorizontalStackLayout>
                            <Label Text="Tipo de servicio: " FontAttributes="Bold" IsVisible="{Binding ServiceType, Converter={StaticResource NullToBoolConverter}}" />
                            <Label Text="{Binding ServiceType}" IsVisible="{Binding ServiceType, Converter={StaticResource NullToBoolConverter}}" />
                        </HorizontalStackLayout>

                        <!-- Servicio -->
                        <HorizontalStackLayout>
                            <Label Text="Servicio: " FontAttributes="Bold" IsVisible="{Binding Service, Converter={StaticResource NullToBoolConverter}}" />
                            <Label Text="{Binding Service}" IsVisible="{Binding Service, Converter={StaticResource NullToBoolConverter}}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <Label Text="Valoraciones recibidas" FontAttributes="Bold" FontSize="18" TextColor="#980c0f" Margin="0,20,0,5" HorizontalTextAlignment="Center"/>
                <CollectionView ItemsSource="{Binding ReceivedScores}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="#ccc" CornerRadius="8" Padding="10" Margin="0,5" MaximumWidthRequest="600">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding ReviewerName}"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            VerticalOptions="CenterAndExpand"
                                            HorizontalOptions="StartAndExpand" />

                                        <ImageButton
                                            Grid.Column="1"
                                            x:Name="btnDeleteScore"
                                            Source="trash.png"
                                            HorizontalOptions="End"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Clicked="btnDeleteScore_Clicked"
                                            IsVisible="{Binding IsMine}"/>
                                    </Grid>
                                    <Label Text="{Binding Rating, StringFormat='⭐ {0}'}" TextColor="#980c0f"/>
                                    <Label Text="{Binding Comment}" FontSize="13" LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding CreatedOn, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" TextColor="Gray" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" RowDefinitions="Auto, Auto">

            <!-- Línea horizontal -->
            <BoxView
                Grid.Row="0"
                HeightRequest="2"
                BackgroundColor="#980c0f"
                HorizontalOptions="FillAndExpand"
                Margin="0,15"/>

            <!-- Botón para dar valorción -->
            <Button
                Grid.Row="1"
                x:Name="btnScoreUser"
                Text="Valorar usuario"
                TextColor="white"
                BackgroundColor="#980c0f"
                Margin="0, 10, 0, 20"
                Command="{Binding GoToProviderProfileCommand}"/>
        </Grid>


    </Grid>

</ContentPage>