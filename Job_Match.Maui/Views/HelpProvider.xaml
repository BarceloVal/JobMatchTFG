<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.HelpProvider"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f4f4f6">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Encabezado -->
            <controls:HeaderControl />

            <VerticalStackLayout Spacing="20" Padding="20">

                <Label Text="Ayuda para usuarios proveedores"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#980c0f" />

                <!-- Buscar ofertas abiertas -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Buscar ofertas abiertas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Explora todas las ofertas abiertas creadas por los clientes. Puedes aplicar filtros por población, tipo de servicio o servicio específico. Al encontrar una oferta de tu interés, puedes inscribirte para que el cliente revise tu perfil y decida si quiere contactarte."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Inscribirse a ofertas -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Inscribirme a ofertas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Una vez inscrito en una oferta, el cliente podrá ver tu perfil completo y decidir si desea contactarte. No necesitas enviar mensajes al inscribirte, pero es recomendable tener tu información actualizada y profesional."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Gestionar mis ofertas inscritas -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mis ofertas inscritas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Consulta las ofertas en las que te has inscrito, filtrando por estado (abierta, en proceso, finalizada, etc.). Puedes revisar los detalles de cada una y prepararte para cuando el cliente se ponga en contacto."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Chats con clientes -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Chats con clientes"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Puedes recibir mensajes de clientes que hayan revisado tu perfil. Desde la sección de chats puedes leer, responder y continuar las conversaciones activas. Solo los clientes pueden iniciar el contacto."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Perfil de proveedor -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mi perfil como proveedor"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Desde tu perfil puedes editar tu nombre comercial, teléfonos, sitio web, descripción del servicio, población y más. También puedes consultar y modificar el tipo de servicio y los servicios asociados. Mantener tu perfil completo y actualizado es clave para atraer clientes."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Valoraciones -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Valoraciones"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Puedes dejar valoraciones a los clientes con los que has trabajado y también ver las reseñas que otros usuarios han dejado sobre ti. Estas valoraciones influyen directamente en tu reputación dentro de la plataforma."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cambiar a cliente -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Cambiar a perfil cliente"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Si deseas solicitar servicios en lugar de ofrecerlos, puedes cambiar a perfil cliente. Si es la primera vez, deberás completar datos básicos. Si ya has sido cliente antes, se reactivará tu cuenta previa. Solo puedes tener un perfil activo a la vez."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Desactivar cuenta -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Desactivar mi cuenta"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Puedes desactivar tu cuenta temporalmente si no deseas recibir nuevas solicitudes ni aparecer en búsquedas. Tu información se conservará por si decides volver más adelante."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
