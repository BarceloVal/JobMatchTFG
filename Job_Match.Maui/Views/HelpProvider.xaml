<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.HelpProvider"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f4f4f6">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Encabezado -->
            <controls:HeaderControl />

            <VerticalStackLayout Spacing="20" Padding="20">

                <!-- Título -->
                <Label Text="Ayuda para usuarios proveedores"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#980c0f" />

                <!-- Buscar ofertas abiertas -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Buscar ofertas abiertas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="En esta sección puedes explorar todas las ofertas abiertas publicadas por clientes. Puedes filtrar las ofertas por población, tipo de servicio o servicio específico, o bien dejar todos los filtros vacíos para ver todas. Una vez encuentres una oferta que te interese, puedes inscribirte con un solo clic. El cliente podrá ver tu perfil antes de decidir si contactarte."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Perfil de proveedor -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mi perfil como proveedor"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Desde tu perfil puedes consultar y editar toda tu información como proveedor: nombre comercial, página web, teléfonos, descripción del servicio que ofreces, y más. También puedes ver el tipo de servicio y el servicio específico al que estás asociado. Mantener tu perfil actualizado aumenta tus posibilidades de ser seleccionado por los clientes."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Inscripción a ofertas -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Inscribirse a ofertas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Cuando veas una oferta abierta que te interese, puedes inscribirte para que el cliente vea tu perfil. No necesitas escribir mensajes ni negociar condiciones en este paso: el cliente verá tu información y decidirá si desea contactarte. Es importante que tengas un perfil completo y profesional para aumentar tus posibilidades."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cambiar de proveedor a cliente -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Cambiar a perfil cliente"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Si deseas volver a actuar como cliente, puedes cambiar tu perfil desde la sección correspondiente. Si nunca has sido cliente antes, deberás completar información básica como dirección, teléfono, etc. Si ya habías sido cliente, simplemente se reactivará tu cuenta anterior. Solo puedes usar un perfil a la vez (cliente o proveedor)."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Desactivar cuenta -->
                <Frame BackgroundColor="#f5f5f5" Padding="15" CornerRadius="10" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Desactivar mi cuenta"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#980c0f"
                               HorizontalOptions="Center" />
                        <Label Text="Desde tu perfil puedes elegir desactivar tu cuenta si ya no deseas utilizar la plataforma. Al hacerlo, tu perfil dejará de ser visible y también se desactivará tu inscripción a servicios y ofertas. Esta opción es útil si deseas tomar un descanso temporal. Podrás volver a activarla en el futuro si lo deseas."
                               FontSize="15"
                               TextColor="#444"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
