<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             xmlns:conv="clr-namespace:Job_Match.Maui.Converters"
             xmlns:vm="clr-namespace:Job_Match.MAUI.ViewModels"
             x:Class="Job_Match.Maui.Views.ChatConversationPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:ChatConversationViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:MessageStyleConverter x:Key="MessageStyleConverter" />

            <Style x:Key="MyMessageStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="LightGreen" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="Margin" Value="10,2" />
            </Style>
            <Style x:Key="OtherMessageStyle" TargetType="Frame">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="Margin" Value="10,2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Encabezado -->
        <controls:HeaderControl Grid.Row="0" />

        <!-- Lista de mensajes -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        Margin="0,10"
                        VerticalOptions="FillAndExpand"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Style="{Binding IsMine, Converter={StaticResource MessageStyleConverter}}"
                        Padding="10"
                        CornerRadius="10"
                        Margin="0, 10, 10, 0"
                        HasShadow="False">
                        <Label Text="{Binding Message}" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Caja de entrada -->
        <Grid Grid.Row="2"
              Padding="10"
              ColumnSpacing="10"
              ColumnDefinitions="*,Auto">

            <!-- Campo de texto estilizado -->
            <Frame Grid.Column="0"
                   CornerRadius="20"
                   Padding="12,6"
                   HasShadow="False"
                   VerticalOptions="Center">
                <Entry Placeholder="Escribe un mensaje..."
                       BackgroundColor="Transparent"
                       Text="{Binding NewMessage}"
                       FontSize="14"
                       HeightRequest="40" />
            </Frame>

            <!-- Botón estilizado -->
            <Button Grid.Column="1"
                    Text="Enviar"
                    Command="{Binding SendMessageCommand}"
                    BackgroundColor="#980c0f"
                    TextColor="White"
                    CornerRadius="20"
                    Padding="20,6"
                    FontSize="14"
                    HeightRequest="40"
                    VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
