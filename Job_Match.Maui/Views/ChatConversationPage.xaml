<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             xmlns:conv="clr-namespace:Job_Match.Maui.Converters"
             xmlns:vm="clr-namespace:Job_Match.MAUI.ViewModels"
             x:Class="Job_Match.Maui.Views.ChatConversationPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:MessageStyleConverter x:Key="MessageStyleConverter" />

            <Style x:Key="MyMessageStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="LightGreen" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="Margin" Value="10,2" />
            </Style>
            <Style x:Key="OtherMessageStyle" TargetType="Frame">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="Margin" Value="5,2,10,2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- ENCABEZADO PERSONALIZADO -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="#980c0f"
            HeightRequest="50"
            VerticalOptions="Start">

            <!-- Flecha de volver -->
            <ImageButton
                Source="arrowback.png"
                Clicked="btnBack_Clicked"
                WidthRequest="35"
                HeightRequest="35"
                Margin="10, 0, 0, 0"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Grid.Column="0" />

            <!-- Nombre del proveedor centrado en el espacio disponible -->
            <Label
                Text="{Binding ProviderName}"
                Grid.Column="1"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="White"
                FontSize="20"
                FontAttributes="Bold" />

            <!-- Caja invisible para equilibrar el ancho -->
            <ContentView Grid.Column="2" WidthRequest="55" />
        </Grid>

        <!-- Lista de mensajes -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        Margin="10, 5, 5, 5"
                        VerticalOptions="FillAndExpand"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Frame Style="{Binding IsMine, Converter={StaticResource MessageStyleConverter}}"
                               CornerRadius="10"
                               Padding="10">
                            <Label Text="{Binding Message}" TextColor="Black" />
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Caja de entrada -->
        <Grid Grid.Row="2"
              Padding="10"
              ColumnSpacing="10"
              ColumnDefinitions="*,Auto">

            <!-- Campo de texto estilizado -->
            <Frame Grid.Column="0"
                   CornerRadius="20"
                   Padding="12,6"
                   HasShadow="False"
                   VerticalOptions="Center">
                <Entry Placeholder="Escribe un mensaje..."
                       BackgroundColor="Transparent"
                       Text="{Binding NewMessage}"
                       FontSize="14"
                       HeightRequest="40" />
            </Frame>

            <!-- Botón estilizado -->
            <Button Grid.Column="1"
                    Text="Enviar"
                    Command="{Binding SendMessageCommand}"
                    BackgroundColor="#980c0f"
                    TextColor="White"
                    CornerRadius="20"
                    Padding="20,6"
                    FontSize="14"
                    HeightRequest="40"
                    VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
