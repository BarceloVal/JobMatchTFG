<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             xmlns:conv="clr-namespace:Job_Match.Maui.Converters"
             xmlns:vm="clr-namespace:Job_Match.MAUI.ViewModels"
             x:Class="Job_Match.Maui.Views.ChatConversationPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:ChatConversationViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:MessageStyleConverter x:Key="MessageStyleConverter" />

            <Style x:Key="MyMessageStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="LightGreen" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="Margin" Value="10,2" />
            </Style>
            <Style x:Key="OtherMessageStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="LightGray" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="Margin" Value="10,2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">

        <!-- Encabezado -->
        <controls:HeaderControl Grid.Row="0" />

        <!-- Lista de mensajes -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        Margin="0,10"
                        VerticalOptions="FillAndExpand"
                        BackgroundColor="LightPink">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{Binding IsMine, Converter={StaticResource MessageStyleConverter}}"
                           Padding="10"
                           CornerRadius="10"
                           HasShadow="False">
                        <Label Text="{Binding Message}" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Caja de entrada -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Entry Placeholder="Escribe un mensaje..."
                   Text="{Binding NewMessage}"
                   FontSize="14"
                   Grid.Column="0" />
            <Button Text="Enviar"
                    Command="{Binding SendMessageCommand}"
                    Grid.Column="1" />
        </Grid>
    </Grid>
</ContentPage>
