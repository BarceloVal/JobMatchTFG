<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.ChatListClientPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Encabezado -->
            <controls:HeaderControl />

            <StackLayout Padding="20">
                <Label Text="Mis Chats"
                       FontSize="24"
                       HorizontalOptions="Center" />

                <CollectionView
                    ItemsSource="{Binding Chats}"
                    SelectionMode="Single"
                    SelectionChanged="CollectionView_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" BackgroundColor="#f0f0f0">
                                <StackLayout>
                                    <Label Text="{Binding ProviderName}" FontAttributes="Bold" />
                                    <Label Text="{Binding LastMessage}" FontSize="14" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding LastMessageDate, StringFormat='{0:g}'}"
                                           FontSize="12" TextColor="Gray" HorizontalOptions="End" />
                                    <Button Text="Probar navegación"
                                            Clicked="Button_Clicked"/>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>