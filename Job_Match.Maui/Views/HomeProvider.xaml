<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.HomeProvider"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Mi encabezado personalizado -->
            <controls:HeaderControl />

            <!-- Buscar ofertas -->
            <Grid VerticalOptions="Start" Margin="0, 40, 0, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Source="myoffers.png"
                    WidthRequest="130"
                    HeightRequest="130"/>

                <Button
                    x:Name="btnoffers"
                    Grid.Row="1"
                    Text="Buscar ofertas abiertas"
                    BackgroundColor="#980c0f"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="20"
                    Clicked="btnoffers_Clicked"
                    MaximumWidthRequest="600"/>

            </Grid>

            <!-- Ver las ofertas en las que esta inscrito el proveedor-->
            <Grid Margin="0, 30, 0, 10" VerticalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Source="mylistoffers.png"
                    WidthRequest="130"
                    HeightRequest="130"/>

                <Button
                    x:Name="btnMyOffers"
                    Grid.Row="1"
                    Text="Ver mis ofertas"
                    BackgroundColor="#980c0f"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="20"
                    Clicked="btnMyOffers_Clicked"
                    MaximumWidthRequest="600"/>

            </Grid>

            <!-- Contactos -->
            <Grid  Margin="0, 0, 0, 50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Source="chats.png"
                    WidthRequest="200"
                    HeightRequest="200"/>

                <Button
                    x:Name="btncontact"
                    Grid.Row="1"
                    Text="Contactos"
                    BackgroundColor="#980c0f"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="20, 0, 20, 0"
                    Clicked="btncontact_Clicked"
                    MaximumWidthRequest="600"/>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

