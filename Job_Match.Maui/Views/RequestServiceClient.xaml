<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.RequestServiceClient"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Mi encabezado personalizado -->
        <controls:HeaderControl Grid.Row="0" />

        <!-- Filtros y botón -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Título -->
                <Label
                    Text="Solicitar servicio"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="0, 10, 0, 10"/>

                <Frame
                    BorderColor="Black"
                    CornerRadius="10"
                    Padding="10"
                    HasShadow="False">
                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Población -->
                            <Picker
                                Title="Población"
                                ItemsSource="{Binding PostalCodes}"
                                SelectedItem="{Binding SelectedPostalCode}"
                                ItemDisplayBinding="{Binding DisplayText}" />
                            <Image
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"
                                Margin="0,0,10,10"/>
                        </Grid>

                        <!-- Tipo de servicio -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Tipo de servicio"
                                ItemsSource="{Binding ServiceTypes}"
                                SelectedItem="{Binding SelectedServiceType}"
                                ItemDisplayBinding="{Binding name}" />
                            <Image
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"
                                Margin="0,0,10,10"/>
                        </Grid>

                        <!-- Servicio -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Servicio"
                                ItemsSource="{Binding FilteredServices}"
                                SelectedItem="{Binding SelectedService}"
                                ItemDisplayBinding="{Binding name}" />
                            <Image
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"
                                Margin="0,0,10,10"/>
                        </Grid>

                        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10">

                            <!-- Botón de limpiar filtros -->
                            <Button
                                x:Name="btnClean"
                                Text="Limpiar filtros"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="45"
                                WidthRequest="150"
                                FontAttributes="Bold"
                                Clicked="btnClean_Clicked" />

                            <!-- Botón de buscar -->
                            <Button
                                x:Name="btnSearch"
                                Text="Buscar"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="45"
                                WidthRequest="150"
                                FontAttributes="Bold"
                                Clicked="btnSearch_Clicked" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Lista de resultados con scroll completo -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredProviders}"
                        VerticalOptions="FillAndExpand"
                        Margin="10">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#ccc"
                           CornerRadius="12"
                           Padding="15"
                           Margin="0,5"
                           HasShadow="True"
                           BackgroundColor="#f9f9f9">

                        <VerticalStackLayout Spacing="6">

                            <!-- Nombre comercial -->
                            <Label Text="{Binding TradeName}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#2c3e50" />

                            <!-- Población -->
                            <Label Text="{Binding PostalCodeName}"
                                   FontSize="14"
                                   TextColor="#7f8c8d" />

                            <!-- Descripción -->
                            <Label Text="{Binding Description}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="#34495e" />

                            <!-- Servicio principal -->
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Services[0].ServiceTypeName}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#2980b9" />

                                <Label Text="{Binding Services[0].Name}"
                                       FontSize="13"
                                       TextColor="#27ae60" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

