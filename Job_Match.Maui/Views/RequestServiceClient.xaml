<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.RequestServiceClient"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Mi encabezado personalizado -->
        <controls:HeaderControl Grid.Row="0" />

        <!-- Cuerpo -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Título -->
                <Label
                    Text="Solicitar servicio"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="0, 10, 0, 10"/>

                <!-- Filtros -->
                <Frame
                    BorderColor="Black"
                    CornerRadius="10"
                    Padding="10"
                    HasShadow="False">
                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Población -->
                            <Picker
                                Title="Población"
                                ItemsSource="{Binding PostalCodes}"
                                SelectedItem="{Binding SelectedPostalCode}"
                                ItemDisplayBinding="{Binding DisplayText}" />
                            <Image
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"
                                Margin="0,0,10,10"/>
                        </Grid>

                        <!-- Tipo de servicio -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Tipo de servicio"
                                ItemsSource="{Binding ServiceTypes}"
                                SelectedItem="{Binding SelectedServiceType}"
                                ItemDisplayBinding="{Binding name}" />
                            <Image
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"
                                Margin="0,0,10,10"/>
                        </Grid>

                        <!-- Servicio -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Servicio"
                                ItemsSource="{Binding FilteredServices}"
                                SelectedItem="{Binding SelectedService}"
                                ItemDisplayBinding="{Binding name}" />
                            <Image
                                Source="arrowdown.png"
                                HeightRequest="20"
                                WidthRequest="20"
                                HorizontalOptions="End"
                                Margin="0,0,10,10"/>
                        </Grid>

                        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10">

                            <!-- Botón de limpiar filtros -->
                            <Button
                                x:Name="btnClean"
                                Text="Limpiar filtros"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="45"
                                WidthRequest="150"
                                FontAttributes="Bold"
                                Clicked="btnClean_Clicked" />

                            <!-- Botón de buscar -->
                            <Button
                                x:Name="btnSearch"
                                Text="Buscar"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="45"
                                WidthRequest="150"
                                FontAttributes="Bold"
                                Clicked="btnSearch_Clicked" />

                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Lista de resultados con scroll completo -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding FilteredProviders}"
            VerticalOptions="FillAndExpand"
            Margin="10">
