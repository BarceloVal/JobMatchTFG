<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.RequestServiceClient"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Mi encabezado personalizado -->
        <controls:HeaderControl Grid.Row="0" />

        <!-- Filtros y botón -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="Solicitar servicio" FontSize="30" FontAttributes="Bold"
                       HorizontalOptions="Center" Margin="0, 10, 0, 10"/>

                <Frame BorderColor="Black" CornerRadius="10" Padding="10" HasShadow="False">
                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="*, Auto">
                            <Picker Title="Población"
                                    ItemsSource="{Binding PostalCodes}"
                                    SelectedItem="{Binding SelectedPostalCode}"
                                    ItemDisplayBinding="{Binding DisplayText}" />
                            <Image Source="arrowdown.png" HeightRequest="20" WidthRequest="20"
                                   HorizontalOptions="End" Margin="0,0,10,10"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Picker Title="Tipo de servicio"
                                    ItemsSource="{Binding ServiceTypes}"
                                    SelectedItem="{Binding SelectedServiceType}"
                                    ItemDisplayBinding="{Binding name}" />
                            <Image Source="arrowdown.png" HeightRequest="20" WidthRequest="20"
                                   HorizontalOptions="End" Margin="0,0,10,10"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Picker Title="Servicio"
                                    ItemsSource="{Binding FilteredServices}"
                                    SelectedItem="{Binding SelectedService}"
                                    ItemDisplayBinding="{Binding name}" />
                            <Image Source="arrowdown.png" HeightRequest="20" WidthRequest="20"
                                   HorizontalOptions="End" Margin="0,0,10,10"/>
                        </Grid>

                        <Button x:Name="btnSearch"
                                Text="Buscar"
                                BackgroundColor="#980c0f"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="45"
                                FontAttributes="Bold"
                                Clicked="btnSearch_Clicked" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Lista de resultados con scroll completo -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredProviders}"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Gray" Padding="10" Margin="10,5">
                        <VerticalStackLayout>
                            <Label Text="{Binding TradeName}" FontAttributes="Bold"/>
                            <Label Text="{Binding Address}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>

