<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Job_Match.Maui.UserControls"
             x:Class="Job_Match.Maui.Views.RequestServiceClient"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Spacing="0">

        <!-- Mi encabezado personalizado -->
        <controls:HeaderControl />

        <!-- Contenido principal -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Título -->
                <Label
                    Text="Solicitar servicio"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="0, 10, 0, 10"/>

                <!-- Contenedor con el borde -->
                <Frame
                    BorderColor="Black"
                    CornerRadius="10"
                    Padding="10"
                    HasShadow="False">

                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Población"
                                ItemsSource="{Binding PostalCodes}"
                                SelectedItem="{Binding SelectedPostalCode}"
                                ItemDisplayBinding="{Binding DisplayText}"/>

                            <!-- Flecha decorativa -->
                            <Image Source="arrowdown.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   HorizontalOptions="End"
                                   Margin="0,0,10,10"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Tipo de servicio"
                                ItemsSource="{Binding ServiceTypes}"
                                SelectedItem="{Binding SelectedServiceType}"
                                ItemDisplayBinding="{Binding name}" />

                            <!-- Flecha decorativa -->
                            <Image Source="arrowdown.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   HorizontalOptions="End"
                                   Margin="0,0,10,10"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Picker
                                Title="Servicio"
                                ItemsSource="{Binding FilteredServices}"
                                SelectedItem="{Binding SelectedService}"
                                ItemDisplayBinding="{Binding name}"
                                HorizontalOptions="FillAndExpand"/>

                            <!-- Flecha decorativa -->
                            <Image Source="arrowdown.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   HorizontalOptions="End"
                                   Margin="0,0,10,10"/>
                        </Grid>

                        <!-- Botón Buscar -->
                        <Button
                            Text="Buscar"
                            BackgroundColor="#980c0f"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </VerticalStackLayout>

</ContentPage>